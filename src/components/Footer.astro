---
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();

const groups = [
  {
    title: '手册',
    links: [
      { href: '/manual', label: '用户手册' },
      { href: '/manual/quickstart', label: '五分钟快速上手' },
      { href: '/manual/interface', label: '界面使用' },
    ],
  },
  {
    title: '查阅',
    links: [
      { href: '/manual/config', label: '配置手册' },
      { href: '/manual/security', label: '安全与审批模型' },
      { href: '/manual/commands', label: '命令速查' },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <div class="footer__logo">
        <BrandMark size={20} uid="foot" />
        <span>heron</span>
      </div>
      <p class="faint">
        跑在本地、配置是文件的多 Agent 运行时。<br />
        「长久静立，瞬间精准出手。」
      </p>
    </div>

    {
      groups.map((group) => (
        <div class="footer__col">
          <h4>{group.title}</h4>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="footer__col">
      <h4>技术栈</h4>
      <ul class="footer__tags">
        <li><span class="badge badge--brand">Go 1.27</span></li>
        <li><span class="badge badge--cyan">SSE</span></li>
        <li><span class="badge">React</span></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span class="faint">© {year} heron</span>
    <span class="faint">内容依据 heron 用户手册整理</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: clamp(44px, 6vw, 72px) 0 28px;
    background: linear-gradient(180deg, transparent, rgba(126, 20, 255, 0.05));
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
    padding-bottom: 40px;
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 17px;
    margin-bottom: 14px;
  }

  .footer__brand p {
    font-size: 14px;
    line-height: 1.8;
  }

  .footer__col h4 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    margin-bottom: 16px;
    font-weight: 600;
  }

  .footer__col ul {
    display: grid;
    gap: 10px;
  }

  .footer__col a {
    font-size: 14.5px;
    color: var(--text-muted);
    transition: color 0.16s ease;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    flex-wrap: wrap;
  }

  @media (max-width: 880px) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
