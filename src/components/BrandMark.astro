---
// heron 标识：苍鹭侧影（自然）+ 电路天线与数据点（科技）。
// 与 public/brand/heron-mark.svg 同一套图形，这里内联以便跟随站点配色。
interface Props {
  size?: number;
  title?: string;
  /** 同一页可能出现多个标识，用它给渐变/遮罩的 id 加前缀，避免 id 重复 */
  uid?: string;
}

const { size = 28, title = 'heron', uid = 'a' } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  role="img"
  aria-label={title}
  class="brand-svg"
>
  <defs>
    <linearGradient
      id={`brandMarkGrad-${uid}`}
      x1="6"
      y1="2"
      x2="46"
      y2="46"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#e6ff5c"></stop>
      <stop offset=".55" stop-color="#dcfd35"></stop>
      <stop offset="1" stop-color="#8fe3ff"></stop>
    </linearGradient>
    <mask id={`brandMarkCut-${uid}`} maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
      <g transform="translate(-11.3 -6.35) scale(1.26)">
        <path
          fill="#fff"
          d="M46.4 15.2 L32.5 12.0 C29.1 11.5 27.5 14.5 29.2 16.7 C31.5 20.2 27.9 24.6 26.9 29.6 L22.2 29.6 C22.9 24.4 26.6 20.4 30.6 17.8 L36.9 17.3 Z"
        ></path>
        <path
          fill="#fff"
          d="M26.9 29.6 C26.1 34.2 27.2 38.6 29.9 41.9 L23.7 41.9 C20.7 38.3 19.4 33.4 22.2 29.6 Z"
        ></path>
        <circle cx="33.5" cy="13.9" r="2.3" fill="#000"></circle>
      </g>
    </mask>
  </defs>

  <rect
    width="48"
    height="48"
    fill={`url(#brandMarkGrad-${uid})`}
    mask={`url(#brandMarkCut-${uid})`}
  ></rect>

  <g
    stroke={`url(#brandMarkGrad-${uid})`}
    stroke-width="1.9"
    fill="none"
    stroke-linejoin="miter"
  >
    <path d="M31.6 9.4 L31.6 4.8 L38.4 4.8"></path>
  </g>
  <circle cx="43" cy="4.8" r="1.6" fill="#8fe3ff"></circle>
</svg>

<style>
  .brand-svg {
    overflow: visible;
  }
</style>
