---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('manual')).sort((a, b) => a.data.order - b.data.order);

// 每章的小节标题：渲染一次拿 headings，页面上直接链到对应锚点。
const chapters = await Promise.all(
  entries.map(async (entry) => {
    const { headings } = await render(entry);
    return {
      slug: entry.data.slug,
      title: entry.data.title,
      chapter: entry.data.chapter,
      sections: headings.filter((h) => h.depth === 2),
    };
  }),
);
---

<Base
  title="heron 用户手册"
  description="heron 用户手册：怎么装、怎么配、怎么用。安装、配置、界面操作、审批模型、多 agent、知识库、命令速查与故障排查。"
>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">User manual</span>
      <h1>heron 用户手册</h1>
      <p>
        面向<strong>使用者</strong>：怎么装、怎么配、怎么用。<br />
        内部设计与取舍不在这里 —— 本手册描述的行为以仓库当前代码为准；
        示例文件均来自仓库里的 <code>.heron-example/</code> 与 <code>initcfg/templates/</code>。
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="chapter-grid">
        {
          chapters.map((c) => (
            <article class="chapter-card" data-enter="flip">
              <a href={`/manual/${c.slug}`} class="chapter-card__link">
                <span class="chapter-card__no">{c.chapter}</span>
                <h2 class="chapter-card__title">{c.title}</h2>
              </a>
              <ul class="chapter-card__sections">
                {c.sections.map((s) => (
                  <li>
                    <a href={`/manual/${c.slug}#${s.slug}`}>{s.text}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="source-note" data-enter="rise">
        手册原文按章拆开，每章一页。左边目录列出全部小节，滚动时会跟着高亮当前小节。
      </p>
    </div>
  </section>
</Base>

<style>
  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }

  .chapter-card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 24px 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .chapter-card:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .chapter-card__link {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .chapter-card__no {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    min-width: 20px;
  }

  .chapter-card__title {
    font-size: 19px;
  }

  .chapter-card__sections {
    display: grid;
    gap: 5px;
    padding-left: 32px;
  }

  .chapter-card__sections a {
    font-size: 13.5px;
    color: var(--text-faint);
    line-height: 1.5;
  }

  .chapter-card__sections a:hover {
    color: var(--accent);
  }

  .source-note {
    margin-top: 28px;
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .source-note code {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .chapter-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
